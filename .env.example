# Public values only: everything prefixed EXPO_PUBLIC_ is bundled into the app.
# Local stack: run `supabase status -o env` and copy API_URL / ANON_KEY.
# Never put the service-role / secret key here.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Customer sign-in: "phone" (SMS code, default) or "email" (email code, for
# deployments without an SMS provider; also set app_config.email_sign_in = true).
EXPO_PUBLIC_AUTH_METHOD=phone
