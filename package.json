{
  "name": "shongrokhon",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/noto-sans-bengali": "^0.4.4",
    "@expo/ui": "~57.0.21",
    "@expo/vector-icons": "^15.0.2",
    "@supabase/supabase-js": "^2.117.2",
    "expo": "~57.0.26",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "qrcode": "^1.5.4",
    "serve": "^14.2.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:db": "supabase test db && ./scripts/check-migrations-idempotent.sh",
    "test:integration": "supabase db reset && node --import tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "check:secrets": "./scripts/check-bundle-secrets.sh",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "qr:fixtures": "tsx scripts/gen-qr-fixtures.ts",
    "postinstall": "node scripts/copy-zxing.mjs",
    "build": "node scripts/copy-zxing.mjs && expo export --platform web",
    "test:e2e": "playwright test",
    "ml:up": "docker compose -f ml/docker-compose.yml up -d --build --wait ml",
    "ml:down": "docker compose -f ml/docker-compose.yml down",
    "ml:train": "docker compose -f ml/docker-compose.yml run --rm --no-deps -v \"$PWD\":/repo -w /repo/ml ml sh -c 'python -m shongrokhon_ml.train && python -m shongrokhon_ml.evaluate && python -m shongrokhon_ml.parity && python -m shongrokhon_ml.seed_export'",
    "ml:seed": "docker compose -f ml/docker-compose.yml run --rm --no-deps -v \"$PWD\":/repo -w /repo/ml ml python -m shongrokhon_ml.seed_export",
    "ml:test": "docker compose -f ml/docker-compose.yml run --rm --no-deps -v \"$PWD\":/repo -w /repo/ml ml python -m pytest -q",
    "ml:network": "docker compose -f ml/docker-compose.yml run --rm network-job python -m shongrokhon_ml.network --once",
    "ml:bench": "docker compose -f ml/docker-compose.yml run --rm --no-deps ml python bench/latency.py --url http://shongrokhon-ml:8000 --sequential 1000"
  },
  "private": true
}
