# Server-side secrets for Edge Functions and the ML container. Never EXPO_PUBLIC_.
# cp supabase/functions/.env.example supabase/functions/.env  and set a random token:
#   openssl rand -hex 24
ML_URL=http://shongrokhon-ml:8000
ML_SERVICE_TOKEN=change-me-to-a-random-token

# AI coach (Phase 3). Without a key the coach falls back to template insights.
# Tests switch to the deterministic mock with app_config.coach_llm_mode = 'mock'.
ANTHROPIC_API_KEY=
COACH_MODEL=claude-opus-5-5
