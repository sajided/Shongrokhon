-- Shared pgTAP helpers, included with \ir from each *.test.sql file.
-- Everything lives in pg_temp, so it disappears with the test session.

create extension if not exists pgtap with schema extensions;

-- Creates an auth user (the trigger adds profile + customer wallet), a live
-- session whose id equals the user id, an optional PIN and an opening balance.
create or replace function pg_temp.mk_user(p_phone text, p_balance numeric default 0, p_pin text default '12345')
returns uuid language plpgsql as $$
declare
  v_id uuid := gen_random_uuid();
begin
  insert into auth.users (instance_id, id, aud, role, phone, phone_confirmed_at, created_at, updated_at)
  values ('00000000-0000-0000-0000-000000000000', v_id, 'authenticated', 'authenticated', p_phone, now(), now(), now());
  insert into auth.sessions (id, user_id, created_at, updated_at) values (v_id, v_id, now(), now());
  if p_pin is not null then
    update public.users set pin_hash = extensions.crypt(p_pin, extensions.gen_salt('bf', 4)) where id = v_id;
  end if;
  if p_balance > 0 then
    perform public.admin_credit_wallet(
      (select id from public.wallets where user_id = v_id and kind = 'customer'), p_balance);
  end if;
  return v_id;
end $$;

create or replace function pg_temp.mk_merchant(p_phone text, p_merchant_id text, p_name text)
returns uuid language plpgsql as $$
declare
  v_id uuid := pg_temp.mk_user(p_phone, 0, '12345');
begin
  update public.users set role = 'merchant' where id = v_id;
  insert into public.wallets (user_id, kind, merchant_id, merchant_name) values (v_id, 'merchant', p_merchant_id, p_name);
  return v_id;
end $$;

create or replace function pg_temp.balance_of(p_user uuid, p_kind public.wallet_kind default 'customer')
returns numeric language sql as $$
  select balance from public.wallets where user_id = p_user and kind = p_kind;
$$;

create or replace function pg_temp.wallet_of(p_user uuid, p_kind public.wallet_kind default 'customer')
returns uuid language sql as $$
  select id from public.wallets where user_id = p_user and kind = p_kind;
$$;

-- Impersonate a signed-in user the way PostgREST does. Undo with `reset role`.
create or replace function pg_temp.as_user(p_user uuid, p_session uuid default null)
returns void language plpgsql as $$
begin
  perform set_config('request.jwt.claims', json_build_object(
    'sub', p_user, 'role', 'authenticated', 'session_id', coalesce(p_session, p_user))::text, true);
  perform set_config('role', 'authenticated', true);
end $$;

create or replace function pg_temp.as_anon()
returns void language plpgsql as $$
begin
  perform set_config('request.jwt.claims', '{"role":"anon"}', true);
  perform set_config('role', 'anon', true);
end $$;

-- Phase 2: make_payment needs a matching server-side score (TC-P2-FLOW-07).
-- Inserts one, as the service would, with the given decision and returns its id.
-- Call it as postgres (before as_user), or let pg_temp.pay call it.
create or replace function pg_temp.mk_score(
  p_user uuid, p_merchant_id text, p_amount numeric, p_key uuid,
  p_decision public.risk_decision default 'ALLOW', p_ttl interval default interval '5 minutes'
) returns uuid language plpgsql security definer as $$
declare
  v_id uuid;
begin
  insert into public.risk_scores (user_id, payer_wallet_id, payee_wallet_id, amount, idempotency_key, features,
                                  risk_score, anomaly_score, decision, source, model_version, expires_at)
  select p_user, payer.id, payee.id, p_amount, p_key, '{}'::jsonb, 0.01, -0.1, p_decision, 'MODEL', 'test', now() + p_ttl
    from public.wallets payer, public.wallets payee
   where payer.user_id = p_user and payer.kind = 'customer'
     and payee.kind = 'merchant' and payee.merchant_id = p_merchant_id
  on conflict (payer_wallet_id, idempotency_key) do update set decision = excluded.decision
  returning id into v_id;
  return v_id;
end $$;

-- The Phase 1 call shape plus a score, for the signed-in user (as_user).
-- SECURITY DEFINER so the score insert works under the authenticated role;
-- make_payment still reads the caller from request.jwt.claims.
create or replace function pg_temp.pay(
  p_merchant_id text, p_amount numeric, p_pin text, p_key uuid, p_note text default null,
  p_decision public.risk_decision default 'ALLOW', p_confirm boolean default false
) returns jsonb language plpgsql security definer as $$
declare
  v_score uuid;
begin
  if p_amount > 0 then
    v_score := pg_temp.mk_score(auth.uid(), p_merchant_id, p_amount, p_key, p_decision);
  end if;
  return public.make_payment(p_merchant_id, p_amount, p_pin, p_key, p_note, v_score, p_confirm);
end $$;

-- Phase 4: an agent (cash-out point) with its own agent wallet.
create or replace function pg_temp.mk_agent(p_phone text, p_code text, p_name text)
returns uuid language plpgsql as $$
declare
  v_id uuid := pg_temp.mk_user(p_phone, 0, '12345');
begin
  update public.users set role = 'agent' where id = v_id;
  insert into public.wallets (user_id, kind, agent_code, agent_name) values (v_id, 'agent', p_code, p_name);
  return v_id;
end $$;

-- Phase 4: a server-side score for a cash-out or transfer (payee = any wallet), as `pay` would record it.
create or replace function pg_temp.mk_flow_score(
  p_user uuid, p_payee_wallet uuid, p_amount numeric, p_key uuid,
  p_decision public.risk_decision default 'ALLOW', p_ttl interval default interval '5 minutes'
) returns uuid language plpgsql security definer as $$
declare
  v_id uuid;
begin
  insert into public.risk_scores (user_id, payer_wallet_id, payee_wallet_id, amount, idempotency_key, features,
                                  decision, source, model_version, expires_at)
  select p_user, payer.id, p_payee_wallet, p_amount, p_key, '{}'::jsonb, p_decision, 'RULES', 'test', now() + p_ttl
    from public.wallets payer where payer.user_id = p_user and payer.kind = 'customer'
  on conflict (payer_wallet_id, idempotency_key) do update set decision = excluded.decision
  returning id into v_id;
  return v_id;
end $$;

-- Phase 4: a compliance analyst (staff account, no customer wallet) with a live session.
create or replace function pg_temp.mk_analyst(p_email text)
returns uuid language plpgsql as $$
declare
  v_id uuid := gen_random_uuid();
begin
  insert into auth.users (instance_id, id, aud, role, email, raw_app_meta_data, created_at, updated_at)
  values ('00000000-0000-0000-0000-000000000000', v_id, 'authenticated', 'authenticated', p_email,
          '{"provider":"email","staff":true}', now(), now());
  insert into auth.sessions (id, user_id, created_at, updated_at) values (v_id, v_id, now(), now());
  insert into public.staff (user_id, email) values (v_id, p_email);
  return v_id;
end $$;
